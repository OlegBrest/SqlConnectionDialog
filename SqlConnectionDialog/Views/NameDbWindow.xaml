<Window x:Class="SqlConnectionDialog.Views.NameDbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SqlConnectionDialog.ViewModel"
        xmlns:vm ="clr-namespace:SqlConnectionDialog.ViewModel"
        mc:Ignorable="d"
        Title="Name of Added DB" Height="90" Width="570" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:NameDbAddedVM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="50"/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Text="{Binding NameDB}" Margin="3" FontSize="20" VerticalContentAlignment="Center"/>
        <Button Grid.Column="1" Content="Ok" Margin="3" FontSize="20" VerticalContentAlignment="Center" Click="Button_Click"/>
    </Grid>
</Window>
